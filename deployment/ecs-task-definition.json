{
  "family": "crediya-microservices",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "authentication-service",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/crediya-authentication-service:latest",
      "portMappings": [
        {
          "containerPort": 8081,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_R2DBC_URL",
          "value": "r2dbc:postgresql://crediya-auth-db.cluster-xyz.region.rds.amazonaws.com:5432/crediya_auth"
        },
        {
          "name": "SPRING_R2DBC_USERNAME",
          "value": "crediya_user"
        }
      ],
      "secrets": [
        {
          "name": "SPRING_R2DBC_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:region:ACCOUNT_ID:secret:crediya/db-password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/crediya-authentication-service",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8081/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    },
    {
      "name": "loan-requests-service",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/crediya-loan-requests-service:latest",
      "portMappings": [
        {
          "containerPort": 8082,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_R2DBC_URL",
          "value": "r2dbc:postgresql://crediya-loans-db.cluster-xyz.region.rds.amazonaws.com:5432/crediya_loans"
        },
        {
          "name": "SPRING_R2DBC_USERNAME",
          "value": "crediya_user"
        },
        {
          "name": "EXTERNAL_SERVICES_AUTHENTICATION_BASE_URL",
          "value": "http://authentication-service:8081"
        }
      ],
      "secrets": [
        {
          "name": "SPRING_R2DBC_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:region:ACCOUNT_ID:secret:crediya/db-password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/crediya-loan-requests-service",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8082/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
